# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public base URL of the customer intake app (used to build shop links/QRs).
INTAKE_BASE_URL=http://localhost:8081

# ── Database (PostgreSQL) ──────────────────────────────
# Used by Prisma once DB layer is wired up.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobody_intake?schema=public

# ── File storage (S3-compatible: AWS S3 / Cloudflare R2) ─
# Leave S3_* blank in dev to use the local-disk fallback (UPLOAD_DIR).
# Set all four (bucket + keys) to switch to S3/R2 automatically.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=autobody-intake-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local-disk fallback location + download link lifetime (seconds).
UPLOAD_DIR=./uploads
DOWNLOAD_URL_TTL=900

# ── Email delivery (Resend) ────────────────────────────
RESEND_API_KEY=
# The "from" address must be a verified domain in Resend.
EMAIL_FROM="AutoBody Intake <intake@yourdomain.com>"

# ── SMS status updates (Twilio) ─────────────────────────
# Leave blank to use the built-in "preview" driver (logged + stored, never
# actually sent) — works with zero telecom setup.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Uploads ────────────────────────────────────────────
MAX_UPLOAD_MB=25

# ── Shop portal auth (JWT) ──────────────────────────────
# MUST be overridden with a long random value in production (the app
# refuses to boot in production with the default dev value).
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=7d

# ── AI triage layer ─────────────────────────────────────
# Leave blank to use the built-in rule-based triage (works with zero setup).
# Set OPENAI_API_KEY to enable LLM-generated summaries instead.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini


