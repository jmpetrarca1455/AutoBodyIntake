# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Public base URL of the customer intake app (used to build shop links/QRs).
INTAKE_BASE_URL=http://localhost:8081

# ── Database (PostgreSQL) ──────────────────────────────
# Used by Prisma once DB layer is wired up.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autobody_intake?schema=public

# ── File storage (S3-compatible: AWS S3 / Cloudflare R2) ─
# Leave S3_* blank in dev to use the local-disk fallback (UPLOAD_DIR).
# Set all four (bucket + keys) to switch to S3/R2 automatically.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=autobody-intake-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local-disk fallback location + download link lifetime (seconds).
UPLOAD_DIR=./uploads
DOWNLOAD_URL_TTL=900

# ── Email delivery (Resend) ────────────────────────────
RESEND_API_KEY=
# The "from" address must be a verified domain in Resend.
EMAIL_FROM="AutoBody Intake <intake@yourdomain.com>"

# ── Uploads ────────────────────────────────────────────
MAX_UPLOAD_MB=25

