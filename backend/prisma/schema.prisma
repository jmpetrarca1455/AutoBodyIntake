// AutoBody Intake — Prisma schema
// Generates a type-safe client for PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A body shop tenant. Each shop has a unique intake token used to build
/// its shareable intake link / QR code, and a destination "secretary"
/// email where completed submissions are delivered.
model Shop {
  id             String   @id @default(cuid())
  name           String
  address        String?
  phone          String?
  /// Inbox at the shop where intake submissions are emailed.
  secretaryEmail String
  /// Login email for the shop owner/staff account (separate from
  /// secretaryEmail, which may be a shared team inbox). Set on signup.
  ownerEmail     String?  @unique
  /// Bcrypt hash of the owner's password. Null until the shop signs up
  /// for portal access (shops created via the old admin API stay email-only).
  passwordHash   String?
  /// Unique, unguessable token embedded in the shop's intake link/QR.
  intakeToken    String   @unique @default(cuid())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  submissions Submission[]
  /// Staff accounts (role STAFF) that can log in under this shop. The
  /// shop's own ownerEmail/passwordHash above remain the OWNER identity —
  /// this table is for additional team members the owner invites.
  staff       ShopUser[]

  @@index([intakeToken])
}

/// Multi-user roles per shop. OWNER is the shop's original signup identity
/// (Shop.ownerEmail/passwordHash); STAFF are additional team members the
/// owner invites via the dashboard. Kept as a plain enum (not a permissions
/// table) since the MVP only needs a binary owner/staff distinction —
/// staff can work submissions but not manage shop settings or other staff.
enum ShopRole {
  OWNER
  STAFF
}

/// A staff login for a shop (see ShopRole doc above). The shop owner invites
/// these from the dashboard; they log in through the same /auth/login
/// endpoint as the owner, keyed by email.
model ShopUser {
  id           String   @id @default(cuid())
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email        String   @unique
  passwordHash String
  role         ShopRole @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shopId])
}

/// Lifecycle of an intake submission as it moves through the shop.
enum SubmissionStatus {
  RECEIVED
  IN_REVIEW
  EMAILED
  ESTIMATE_READY
  IN_REPAIR
  READY_FOR_PICKUP
  COMPLETED
  FAILED
  ARCHIVED
}

/// A single customer intake submission for a shop. The full structured
/// form payload is stored in `data` (JSON) so the form can evolve without
/// a migration for every field, while frequently-queried/searchable fields
/// are promoted to real columns and indexed.
model Submission {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  status SubmissionStatus @default(RECEIVED)

  // ── Promoted, searchable summary fields ──────────────
  customerName  String
  customerEmail String?
  customerPhone String?
  vehicleInfo   String? // e.g. "2021 Toyota Camry"
  claimNumber   String?

  /// Full validated intake payload (all field groups).
  data Json

  /// Uploaded files/photos linked to this submission.
  attachments Attachment[]

  /// Timestamp the packaged email was successfully delivered.
  emailedAt DateTime?

  /// AI-generated triage: priority, missing info, suggested next action,
  /// short summary. Regenerable; best-effort (never blocks the intake flow).
  aiSummary            Json?
  aiSummaryGeneratedAt DateTime?

  /// AI-generated damage severity/scope read from the damage photos +
  /// description — a triage aid for staff, never a substitute for a
  /// certified estimate. Regenerable; best-effort.
  damageAssessment            Json?
  damageAssessmentGeneratedAt DateTime?

  /// Full audit log of customer status-update texts/emails and adjuster
  /// follow-up emails sent for this submission.
  communications CommunicationLog[]

  /// Line-item repair estimate (parts/labor/paint materials/sublet/misc) —
  /// the shop's real cost estimate, distinct from the AI's rough triage
  /// damage-assessment range.
  estimateLines EstimateLineItem[]

  /// Parts on order for this repair (procurement/tracking).
  partsOrders PartsOrder[]

  /// Scheduled drop-off/pickup appointments (shop capacity planning).
  dropoffScheduledAt DateTime?
  pickupScheduledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, createdAt])
  @@index([status])
}

/// A file/photo attached to a submission (license, insurance card,
/// damage photos, etc.). Binary lives in object storage; we keep metadata.
model Attachment {
  id           String @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// Logical category, e.g. "insurance_card_front", "damage_photo".
  kind        String
  fileName    String
  contentType String
  sizeBytes   Int
  /// Object-storage key/path (S3/R2). Populated once storage is wired.
  storageKey  String?

  /// AI-extracted document fields (license/insurance card/VIN OCR).
  /// Null until OCR has run; regenerable; best-effort like AI triage.
  ocrData        Json?
  ocrGeneratedAt DateTime?

  createdAt DateTime @default(now())

  @@index([submissionId])
}

/// Audit log of every customer status-update (SMS/email), adjuster
/// follow-up email, parts-supplier/insurance email, and manually-logged
/// note/call for a submission — the full communications history shown in
/// the dashboard, organized by `recipientType` so staff can filter by
/// conversation instead of scanning one flat list.
model CommunicationLog {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// "sms" | "email" | "note" | "call"
  channel String
  /// "outbound" | "inbound" | "internal" (manually-logged notes/calls)
  direction String @default("outbound")
  /// "customer" | "adjuster" | "insurance" | "parts_supplier" | "internal" | "other"
  recipientType String @default("customer")
  /// Freeform label for who this was with when it's not simply "the
  /// customer", e.g. an adjuster's name or a parts supplier's name.
  recipientLabel String?
  /// One of the shared StatusMilestone values, or null for non-status-update messages.
  milestone String?
  /// Email only.
  subject String?
  body    String
  /// True when an AI draft was used as-is (vs. staff writing/editing it).
  aiDrafted Boolean @default(false)
  /// "sent" | "failed" | "preview" (no real SMS/email provider configured) | "logged" (manual note/call)
  status String

  createdAt DateTime @default(now())

  @@index([submissionId, createdAt])
  @@index([submissionId, recipientType])
}

/// Category of a line-item estimate charge — mirrors how CCC ONE and every
/// shop management system breaks down a repair order's total.
enum EstimateLineCategory {
  PARTS
  LABOR
  PAINT_MATERIALS
  SUBLET
  MISC
}

/// A single line of the shop's real repair cost estimate (as opposed to the
/// AI's rough triage damage-assessment range). Parts/labor/paint
/// materials/sublet/misc, the same breakdown every collision estimate uses.
model EstimateLineItem {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  category    EstimateLineCategory
  description String
  /// OEM/aftermarket part number, when applicable (PARTS category).
  partNumber String?
  quantity   Float                @default(1)
  /// Unit price for PARTS/MISC/SUBLET, or hourly rate for LABOR.
  unitPrice  Float                @default(0)
  /// Hours, for LABOR category only.
  laborHours Float?
  /// Computed line total (quantity × unitPrice, or laborHours × unitPrice
  /// for LABOR) — stored so totals don't require recomputation client-side.
  total Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
}

/// Procurement status of a single ordered part — tracks a part from
/// "we need this" through installation, the #1 cycle-time bottleneck in
/// collision repair.
enum PartsOrderStatus {
  NEEDED
  ORDERED
  BACKORDERED
  RECEIVED
  INSTALLED
  RETURNED
}

/// A part being sourced for a repair (procurement tracking) — separate from
/// EstimateLineItem since a part can be re-ordered, backordered, or
/// returned without changing the estimate's line items.
model PartsOrder {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  description String
  partNumber  String?
  supplier    String?
  status      PartsOrderStatus @default(NEEDED)
  cost        Float?
  orderedAt   DateTime?
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([submissionId])
  @@index([status])
}













