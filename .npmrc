# Disable npm's automatic peer-dependency installation.
#
# Without this, npm (v7+) auto-installs "latest" versions to satisfy any
# unpinned peerDependencies it finds anywhere in the tree (e.g. a tool's
# loose "react-native": "*" peer). In this monorepo that caused npm to
# install a rogue react-native@latest + react@19 + metro@0.87 at the
# workspace root — completely unrelated to the app's pinned
# react-native@0.74.5 / expo SDK 51 — which then won by Node's module
# resolution order (root node_modules is checked before app/node_modules),
# breaking `expo start --web` with a Metro/@expo-cli version mismatch
# ("Package subpath './src/lib/TerminalReporter' is not defined by exports").
#
# legacy-peer-deps restores npm v6 behavior: peer deps are reported but
# never auto-installed, so only what each package.json actually declares
# gets installed.
legacy-peer-deps=true

